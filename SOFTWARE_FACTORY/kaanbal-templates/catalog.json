        "scaffold",
        "empty",
        "upload"
      ],
      "health_check_path": "/api/health",
      "consumes": [
        {"kind": "database", "engine": "mongodb", "optional": true},
        {"kind": "database", "engine": "postgres", "optional": true}
      ],
      "config_schema": {
        "node_version": {
          "type": "string",
          "enum": ["22", "20"],
          "default": "22",
          "label": "Versión de Node.js"
        }
      },
      "env_vars": [
        {"name": "APP_NAME", "default": "{{APP_NAME}}"},
        {"name": "APP_ENV", "default": "production"},
        {"name": "NODE_ENV", "default": "production"}
      ],
      "secrets": [
        {"name": "APP_SECRET", "auto_generate": true, "length": 32}
      ]
    },
    {
      "id": "mongodb",
      "name": "MongoDB",
      "description": "MongoDB document database — secrets in Vault; bind from Wizard",
      "icon": "mongodb",
      "color": "#47a248",
      "category": "database",
      "stack": ["mongodb"],
      "popular": true,
      "status": "ready",
      "port": 27017,
      "service_type": "tcp",
      "needs_repo": false,
      "creation_modes": ["config-only"],
      "docker_image": "mongo:7",
      "tailscale_tags": ["tag:k8s", "tag:database"],
      "volumes": [
        {"name": "data", "mount_path": "/data/db", "size": "5Gi"}
      ],
      "secrets": [
        {"name": "MONGO_INITDB_ROOT_USERNAME", "auto_generate": false, "pattern": "{env_prefix}admin"},
        {"name": "MONGO_INITDB_ROOT_PASSWORD", "auto_generate": true, "length": 24},
        {"name": "MONGO_INITDB_DATABASE", "auto_generate": false, "pattern": "{app_name_underscore}"}
      ]
    },
    {
      "id": "postgres",
      "name": "PostgreSQL",
      "description": "PostgreSQL database — secrets in Vault; bind from Wizard",
      "icon": "postgres",
      "color": "#336791",
      "category": "database",
      "stack": ["postgresql"],
      "popular": true,
      "status": "ready",
      "port": 5432,
      "service_type": "tcp",
      "needs_repo": false,
      "creation_modes": ["config-only"],
      "docker_image": "postgres:16",
      "tailscale_tags": ["tag:k8s", "tag:database"],
      "volumes": [
        {"name": "data", "mount_path": "/var/lib/postgresql/data", "size": "5Gi"}
      ],
      "env_vars": [
        {"name": "PGDATA", "value": "/var/lib/postgresql/data/pgdata"}
      ],
      "secrets": [
        {"name": "POSTGRES_USER", "auto_generate": false, "pattern": "{env_prefix}admin"},
        {"name": "POSTGRES_PASSWORD", "auto_generate": true, "length": 24},
        {"name": "POSTGRES_DB", "auto_generate": false, "pattern": "{app_name_underscore}"}
      ]
    },
    {
      "id": "n8n",
      "name": "n8n",
      "description": "Workflow automation — choose Public or VPN per environment (full channel)",
      "icon": "n8n",
      "color": "#ff6d5a",
      "category": "workflow",
      "stack": ["n8n"],
      "popular": true,
      "status": "ready",
      "port": 5678,
      "service_type": "http",
      "needs_repo": false,
      "creation_modes": ["config-only"],
      "docker_image": "n8nio/n8n:latest",
      "resources": {
        "requests": {"cpu": "100m", "memory": "512Mi"},
        "limits": {"cpu": "1000m", "memory": "2Gi"}
      },
      "env_vars": [
        {"name": "N8N_LISTEN_ADDRESS", "default": "0.0.0.0"},
        {"name": "N8N_PORT", "default": "5678"},
        {"name": "NODE_OPTIONS", "default": "--max-old-space-size=1024"},
        {"name": "N8N_DIAGNOSTICS_ENABLED", "default": "false"},
        {"name": "N8N_EDITOR_BASE_URL", "default": "https://{{APP_NAME}}.{{DOMAIN}}"},
        {"name": "WEBHOOK_URL", "default": "https://{{APP_NAME}}.{{DOMAIN}}/"}
      ],
      "volumes": [
        {"name": "data", "mount_path": "/home/node/.n8n", "size": "2Gi"}
      ],
      "exposure": {
        "mode": "public",
        "surfaces": {
          "ui":      { "via": "auto", "path": "/", "label": "n8n UI" },
          "webhook": { "via": "auto", "path": "/webhook/", "label": "Webhooks" },
          "mcp":     { "via": "auto", "path": "/mcp/", "label": "MCP server" }
        }
      },
      "secrets": [
        {"name": "N8N_ENCRYPTION_KEY", "auto_generate": true, "length": 32}
      ]
    },
    {
      "id": "emqx",
      "name": "EMQX",
      "description": "MQTT broker Edge profile — LAN + Tailscale + WSS público (sin MQTT TCP en Internet)",
      "icon": "emqx",
      "color": "#5e6ad2",
      "category": "iot",
      "stack": ["mqtt", "emqx"],
      "popular": true,
      "status": "ready",
      "port": 18083,
      "service_type": "http",
      "needs_repo": false,
      "creation_modes": ["config-only"],
      "docker_image": "emqx/emqx:5.8.3",
      "tailscale_tags": ["tag:k8s", "tag:iot"],
      "kind": "managed-service",
      "deployment_driver": "emqx-edge",
      "profiles": ["edge", "custom"],
      "default_profile": "edge",
      "volumes": [
        {
          "name": "data",
          "mount_path": "/opt/emqx/data",
          "size": "5Gi",
          "retain_on_delete": true
        }
      ],
      "ports": [
        {"name": "mqtt", "port": 1883, "protocol": "TCP", "description": "MQTT TCP (ESP32 / n8n / edge)"},
        {"name": "ws", "port": 8083, "protocol": "TCP", "description": "MQTT over WebSocket"},
        {"name": "dashboard", "port": 18083, "protocol": "TCP", "description": "EMQX Dashboard (admin)"}
      ],
      "tailscale_tcp_ports": ["mqtt", "ws", "dashboard"],
      "port_defaults": {
        "mqtt": ["internal", "lan", "tailscale"],
        "ws": ["internal", "lan", "tailscale", "public"],
        "dashboard": ["internal", "lan", "tailscale"]
      },
      "port_channels_policy": {
        "mqtt": {"forbid_public": true},
        "ws": {"allow_public": true, "public_path": "/mqtt", "public_host_prefix": "mqtt"},
        "dashboard": {"allow_public": false, "warn_public": true}
      },
      "config_schema": {
        "profile": {
          "type": "string",
          "enum": ["edge", "custom"],
          "default": "edge",
          "label": "Perfil de despliegue"
        },
        "topic_prefix": {
          "type": "string",
          "default": "acuaponia",
          "label": "Prefijo de topics MQTT"
        },
        "storage_size": {
          "type": "string",
          "default": "5Gi",
          "label": "Tamaño PVC"
        }
      },
      "exposure": {
        "mode": "tailscale",
        "surfaces": {
          "dashboard": { "via": "auto", "path": "/", "label": "Dashboard (L7 HTTP)" },
          "mqtt":      { "via": "tcp",  "path": "",  "label": "MQTT (L4 :1883)" },
          "ws":        { "via": "tcp",  "path": "/mqtt", "label": "MQTT over WS / WSS" }
        }
      },
      "secrets": [
        {"name": "EMQX_DASHBOARD__DEFAULT_USERNAME", "auto_generate": false, "pattern": "admin"},
        {"name": "EMQX_DASHBOARD__DEFAULT_PASSWORD", "auto_generate": true, "length": 24},
        {"name": "EMQX_MQTT_DEVICE_USERNAME", "auto_generate": false, "pattern": "device"},
        {"name": "EMQX_MQTT_DEVICE_PASSWORD", "auto_generate": true, "length": 24},
        {"name": "EMQX_MQTT_FRONTEND_USERNAME", "auto_generate": false, "pattern": "frontend"},
        {"name": "EMQX_MQTT_FRONTEND_PASSWORD", "auto_generate": true, "length": 24},
        {"name": "EMQX_TOPIC_PREFIX", "auto_generate": false, "pattern": "acuaponia"}
      ],
      "resources": {
        "requests": {"cpu": "100m", "memory": "256Mi"},
        "limits": {"cpu": "500m", "memory": "512Mi"}
      }
    }
  ],
