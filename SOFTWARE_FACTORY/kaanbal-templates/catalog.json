      "popular": true,
      "status": "ready",
      "port": 8000,
      "service_type": "http",
      "creation_modes": ["scaffold", "empty", "upload"],
      "health_check_path": "/health",
      "consumes": [
        {"kind": "database", "engine": "postgres", "optional": true}
      ],
      "config_schema": {
        "php_version": {
          "type": "string",
          "enum": ["8.4"],
          "default": "8.4",
          "label": "Versión de PHP"
        }
      },
      "env_vars": [
        {"name": "APP_NAME", "default": "{{APP_NAME}}"},
        {"name": "APP_ENV", "default": "production"},
        {"name": "APP_DEBUG", "default": "false"}
      ],
      "secrets": [
        {"name": "APP_KEY", "auto_generate": true, "format": "laravel-key"}
      ]
    },
    {
      "id": "nextjs-fullstack",
      "name": "Next.js full-stack",
      "description": "Next.js 16 con App Router: páginas y API en la misma app, lista para vincular una base",
      "icon": "nextjs",
      "color": "#0ea5e9",
      "category": "backend",
