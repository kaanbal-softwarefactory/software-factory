# Copia este archivo a .env.local si quieres apuntar a otra API:
#   cp .env.example .env.local
#
# Vite resuelve estas variables AL CONSTRUIR, no en el navegador. Por eso hay
# una por entorno y el mismo código sirve en local y en el clúster:
#
#   .env.development → la usa `npm run dev`   (tu API en localhost)
#   .env.production  → la usa `npm run build` (la API que Kaanbal publicó)

VITE_API_URL=http://localhost:8000
