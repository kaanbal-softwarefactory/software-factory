# Copia este archivo a .env para desarrollo local:  cp .env.example .env
#
# En el clúster NO se usa: Kaanbal inyecta estas mismas variables desde Vault.
# Los nombres son los mismos en los dos lados, y por eso el código no cambia.

APP_NAME=placeholder-app

# ── Base de datos ────────────────────────────────────────────────────────
# Levanta la tuya con:  docker compose up -d
# Kaanbal inyecta MONGO_URI / DATABASE_URL (y además <NOMBRE_DE_LA_BASE>_URI).
MONGO_URI=mongodb://localhost:27017
# Si tu stack usa PostgreSQL, comenta la de arriba y descomenta esta:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Nombre de la base dentro del motor. Por defecto, el de la app con guiones bajos.
# DB_NAME=placeholder_app

# ── Quién puede llamar a esta API desde un navegador ─────────────────────
# En local, el dev server del frontend. En el clúster, el dominio del sitio.
CORS_ORIGINS=http://localhost:5173
