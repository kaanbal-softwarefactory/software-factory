# Copia este archivo a .env.local para desarrollo. En Kaanbal estas variables
# llegan solas: las de la app desde la consola y las de la base al vincularla.

APP_NAME=placeholder-app
APP_ENV=development

# Base de datos (opcional). Sin ninguna, la app usa datos en memoria.
# MongoDB:
# MONGODB_URI=mongodb://CHANGE_ME:CHANGE_ME@localhost:27017/app?authSource=admin
# PostgreSQL:
# DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@localhost:5432/app
