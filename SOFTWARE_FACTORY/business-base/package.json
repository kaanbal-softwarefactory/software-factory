{
  "name": "@kaanbal/business-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && node scripts/prepare.mjs",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/*.integration.ts",
    "migrate": "tsx scripts/migrate.ts",
    "worker": "tsx scripts/worker.ts",
    "local:up": "node scripts/local.mjs up",
    "local:stop": "node scripts/local.mjs stop",
    "local:access": "node scripts/local.mjs access",
    "copy": "node scripts/create-copy.mjs",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "jose": "6.1.3",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "openid-client": "6.8.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/nodemailer": "7.0.11",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.62.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
