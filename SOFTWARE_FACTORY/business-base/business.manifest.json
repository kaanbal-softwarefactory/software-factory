  "version": "0.1.0",
  "stage": "prototype",
  "template_ready": false,
  "database": "postgresql",
  "identity": { "protocol": "oidc", "default_provider": "keycloak" },
  "modules": [
    "identity",
    "organizations",
    "authorization",
    "landing",
    "catalog",
    "inbox",
    "customer-portal",
    "appointments",
    "notifications",
    "audit"
